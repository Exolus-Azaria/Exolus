<section id="page-settings" class="page hidden"><h1><span class="ui-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 3a9 9 0 1 0 0 18h1.5a2 2 0 0 0 1.4-3.4 1.5 1.5 0 0 1 1.1-2.6H18a3 3 0 0 0 3-3c0-5-4-9-9-9Z"/><circle cx="7.5" cy="10" r="1"/><circle cx="11" cy="6.5" r="1"/><circle cx="16" cy="8" r="1"/></svg></span> Pengaturan Tampilan</h1><div class="panel"><h2>Tema Warna</h2><div class="field"><label>Pilih preset</label><select id="theme"><option value="blue">Cyber Blue</option><option value="purple">Phantom Purple</option><option value="green">Matrix Green</option><option value="red">Crimson Red</option><option value="orange">Solar Orange</option><option value="white">Minimal White</option><option value="custom">Custom Color</option></select></div><div class="field"><label>Warna aksen kustom</label><div class="row"><input type="color" id="customColor" value="#36c9ff"><span class="muted">Pilih warna utama UI</span></div></div></div>
<div class="panel"><h2><span class="ui-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9" r="1.5"/><path d="m21 15-5-5L5 20"/></svg></span> Background</h2><div class="field"><label>Jenis background</label><select id="bgType"><option value="default">Bawaan futuristik</option><option value="photo">Foto / GIF dari perangkat</option><option value="video">Video dari perangkat</option><option value="url">URL gambar / GIF / video</option><option value="color">Warna polos</option></select></div><div class="field" id="bgPhotoField"><label>Foto atau GIF</label><div class="file-control"><input type="file" id="bgFile" accept="image/*,.gif"><button class="file-clear" type="button" id="clearPhoto">Batal pilih</button></div></div><div class="field hidden" id="bgVideoField"><label>Video</label><div class="file-control"><input type="file" id="videoFile" accept="video/*"><button class="file-clear" type="button" id="clearVideo">Batal pilih</button></div></div><div class="field hidden" id="bgUrlField"><label>URL gambar, GIF, atau video</label><input type="url" id="bgUrl" placeholder="https://contoh.com/background.jpg"><button class="file-clear" type="button" id="clearUrl">Hapus URL</button></div><div class="field"><label>Lapisan gelap: <span id="shadeLabel">68%</span></label><input id="shade" type="range" min="10" max="90" value="68"></div><div class="row"><button class="btn" id="applyBg">Terapkan background</button><button class="btn secondary" id="resetBg">Reset</button></div><p class="notice">Pilih satu jenis background, lalu terapkan. Kamu bisa mengatur tingkat gelap agar teks tetap terbaca.</p></div>
<div class="panel"><h2><span class="ui-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg></span> Waktu & Lokasi</h2><div class="field"><label>Zona waktu</label><select id="tz"><option value="Asia/Pontianak">Pontianak / Kalimantan Barat — WIB</option><option value="Asia/Jakarta">Jakarta — WIB</option><option value="Asia/Makassar">Makassar — WITA</option><option value="Asia/Jayapura">Jayapura — WIT</option></select></div><div class="field"><label>Label lokasi</label><input id="locLabel" type="text" value="Pontianak, Kalimantan Barat"></div><button class="btn" id="saveLocation">Simpan waktu & lokasi</button></div></section>
