.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:18px}.card{border:1px solid var(--border);border-radius:17px;padding:21px;background:var(--panel);min-width:0;transition:border-color .15s ease,background .15s ease}.card[data-goto]{cursor:pointer}.card[data-goto]:hover{border-color:var(--accent);background:var(--panel2)}.card:active{transform:none}.card-head{display:flex;align-items:center;gap:12px}.card-icon{width:44px;height:44px;border-radius:13px;display:grid;place-items:center;background:rgba(54,201,255,.12);border:1px solid rgba(54,201,255,.2);color:var(--accent);font-size:23px;flex-shrink:0}.card h3{margin:0;font-size:16px}.card p{margin:12px 0 0;color:var(--muted);font-size:13px}.status-list{display:grid;gap:11px;margin-top:14px}.status-row{display:flex;justify-content:space-between;gap:12px;font-size:13px}.good{color:#47e4a5}.warning{color:#ffd27a}.section-title{margin:28px 0 10px;font-size:19px}.layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:16px}.chatbox{display:flex;flex-direction:column;min-height:420px}.messages{flex:1;display:flex;flex-direction:column;gap:12px;padding:8px 0 18px}.bubble{max-width:88%;padding:12px 14px;border-radius:14px;background:var(--panel2);border:1px solid var(--border);overflow-wrap:anywhere}.bubble.user{align-self:flex-end;background:rgba(54,201,255,.13)}.composer{display:flex;gap:8px}.composer input{flex:1;min-width:0;border:1px solid var(--border);border-radius:12px;background:rgba(2,9,22,.9);color:var(--text);padding:13px;font:inherit}.muted{color:var(--muted)}.hidden{display:none!important}.panel{border:1px solid var(--border);border-radius:17px;background:var(--panel);padding:clamp(16px,2vw,24px);margin-bottom:16px;min-width:0}.panel h2{margin-top:0}.field{display:grid;gap:8px;margin:16px 0}.field label{font-size:14px;color:var(--muted)}input[type=text],input[type=url],select{width:100%;min-height:44px;padding:11px;border-radius:10px;border:1px solid var(--border);background:#08152a;color:var(--text);font:inherit}input[type=color]{width:48px;height:38px;border:0;background:transparent}input[type=range]{width:100%;accent-color:var(--accent)}.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.file-list{display:grid;gap:8px}.file-item{padding:11px;border:1px solid var(--border);border-radius:10px;background:var(--panel2);font-size:13px;overflow-wrap:anywhere}.upload{border:1px dashed var(--border);border-radius:12px;padding:16px;text-align:center;color:var(--muted)}.notice{font-size:12px;color:var(--muted);line-height:1.6}
