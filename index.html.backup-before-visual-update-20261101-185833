.hero p,.card p,.field label,.muted,.notice,.place-value{color:var(--muted)}
.card[data-goto]:hover{background:var(--panel2);border-color:var(--accent)}
input[type=text],input[type=url],select,.composer input{background:var(--input);color:var(--text);border-color:var(--border)}
input::placeholder{color:var(--muted)}
.btn{color:var(--text);border-color:var(--accent)}.btn.secondary{background:var(--panel2);color:var(--text);border-color:var(--border)}
.time-value{display:flex;align-items:flex-start;gap:3px;color:var(--text);font-variant-numeric:tabular-nums}.time-value sup{font-size:.5em;line-height:1.2;position:relative;top:.08em;letter-spacing:0;color:var(--accent);font-weight:750}.time-period{font-size:11px;color:var(--accent);font-weight:700;letter-spacing:.4px;margin-top:1px}
.timezone{color:var(--accent);border-color:var(--border)}
.status-pill.good{color:#087a50}.status-pill.bad{color:#b4233c}
[data-theme="white"] .dot{background:#079b68;box-shadow:0 0 10px #079b68}
