/* Exolus v2.2.4: subtle futuristic motion and live connection indicators */
@keyframes exolusGlow{0%,100%{box-shadow:0 0 0 rgba(54,201,255,0)}50%{box-shadow:0 0 24px rgba(54,201,255,.08)}}
@keyframes exolusRise{from{opacity:.72;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
.hero{animation:exolusGlow 7s ease-in-out infinite}.card,.panel{transition:border-color .2s ease,background .2s ease,box-shadow .2s ease}.card:hover,.panel:hover{box-shadow:0 10px 32px rgba(0,0,0,.13)}.page:not(.hidden){animation:exolusRise .22s ease-out}.status-pill{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--border);border-radius:999px;padding:5px 9px;font-size:12px;white-space:nowrap}.status-pill::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor;box-shadow:0 0 9px currentColor}.status-pill.good{color:#47e4a5;border-color:rgba(71,228,165,.25)}.status-pill.bad{color:#ff7585;border-color:rgba(255,117,133,.25)}.status-pill.wait{color:#ffd27a;border-color:rgba(255,210,122,.25)}.status-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:8px 0 16px}.status-card-title{display:flex;align-items:center;gap:8px}.status-detail{font-size:12px;color:var(--muted);overflow-wrap:anywhere}.status-row b{font-size:12px}.btn:focus-visible,.nav:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}

/* Theme-aware components: all UI surfaces follow the selected palette. */
:root{--muted:#afc1d6;--panel2:rgba(13,31,58,.92);--sidebar:rgba(3,10,23,.97);--input:#08152a;--hero1:rgba(3,12,29,.95);--hero2:rgba(12,34,66,.88)}
