button:focus-visible,[data-goto]:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:3px}


/* Exolus UI consistency fixes */
.card:not([data-goto]){cursor:default}.card:not([data-goto]):hover{box-shadow:none;border-color:var(--border);background:var(--panel)}
.nav,.btn,.file-clear{transition:background .16s ease,border-color .16s ease,color .16s ease}
button:disabled{opacity:.62;cursor:wait}
.datetime{background:var(--panel);color:var(--text)}
.hero h1,.panel h1,.panel h2,.page h1,.card h3{color:var(--text)}
